    {
      "source": "/health",
      "destination": "https://rtcrackers-customer-api.vercel.app/health"
    },
    {
      "source": "/:a/:b/runtime/:path*",
      "destination": "/runtime/:path*"
    },
    {
      "source": "/:a/runtime/:path*",
      "destination": "/runtime/:path*"
    },
    {
      "source": "/:a/:b/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/:a/assets/:path*",
      "destination": "/assets/:path*"
    },
