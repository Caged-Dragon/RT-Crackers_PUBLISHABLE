# Vercel project: rtcrackers-admin-api   (Root Directory: admin-api, Framework: FastAPI)
# Add these under Project -> Settings -> Environment Variables (Production). Never commit real values.

ENVIRONMENT=production
APP_NAME=RTCrackers Admin API
API_V1_PREFIX=/api/v1/admin

# Supabase -> Project -> Connect -> "Transaction pooler" (port 6543). Copy the EXACT string from the dashboard.
# Do NOT use the direct db.<ref>.supabase.co host: it is IPv6-only and Vercel cannot reach it.
DATABASE_URL=postgresql://postgres.josnuaaupzylzgvvnydg:<DB_PASSWORD>@<POOLER_HOST>:6543/postgres
DB_SSL_MODE=require
DB_NULL_POOL=true

# 48+ random chars:  python3 -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=<generate a DIFFERENT value from the customer API>

# Same-origin through the site's rewrites, so the cookie is set for the site's own domain.
FRONTEND_URL=https://rtcrackers.vercel.app
CORS_ORIGINS=https://rtcrackers.vercel.app
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN: leave unset

# Vercel's filesystem is read-only except /tmp; real uploads go to Supabase Storage.
LOCAL_MEDIA_DIR=/tmp/media
STORAGE_BACKEND=supabase
SUPABASE_URL=https://josnuaaupzylzgvvnydg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<Supabase -> Settings -> API Keys -> service_role (secret)>
SUPABASE_STORAGE_BUCKET=rt-media

# Mail (use console until SMTP is ready; "console" only logs messages)
EMAIL_BACKEND=console
# EMAIL_BACKEND=smtp
# SMTP_HOST=  SMTP_PORT=587  SMTP_USERNAME=  SMTP_PASSWORD=  SMTP_START_TLS=true  SMTP_USE_TLS=false
EMAIL_FROM=RT Crackers <no-reply@rtcrackers.com>
ORDER_ADMIN_EMAILS=support@rtcrackers.com
