{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/v1/admin/:path*",
      "destination": "https://rtcrackers-admin-api.vercel.app/api/v1/admin/:path*"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "https://rtcrackers-customer-api.vercel.app/api/v1/:path*"
